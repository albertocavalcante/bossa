load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy", "rust_doc", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "bossa-sdk",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bossa_sdk",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [
        "//crates/declarative",
        "@crates//:anyhow",
        "@crates//:blake3",
        "@crates//:dirs",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:shellexpand",
        "@crates//:tempfile",
        "@crates//:thiserror",
        "@crates//:toml",
    ] + select({
        "@platforms//os:linux": ["@crates//:rustix"],
        "@platforms//os:osx": ["@crates//:rustix"],
        "//conditions:default": [],
    }),
)

rust_test(
    name = "bossa_sdk_test",
    compile_data = glob(["fixtures/*.sh"]),
    crate = ":bossa-sdk",
)

rust_clippy(
    name = "bossa_sdk_clippy",
    deps = [":bossa-sdk"],
)

rust_doc(
    name = "bossa_sdk_doc",
    crate = ":bossa-sdk",
)

rust_binary(
    name = "configured_setup_example",
    srcs = ["examples/configured_setup.rs"],
    crate_root = "examples/configured_setup.rs",
    edition = "2024",
    deps = [
        ":bossa-sdk",
        "//crates/declarative",
        "@crates//:anyhow",
    ],
)
