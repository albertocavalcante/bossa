"""Bazel module for bossa CLI."""

module(name = "bossa")

# Core dependencies
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_rust", version = "0.68.1")
bazel_dep(name = "rules_shell", version = "0.6.1")

# Rust toolchain configuration
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Crate universe - read dependencies from Cargo.toml (workspace root)
# Workspace members are automatically discovered from Cargo.toml [workspace] section
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)

# pintui is a Cargo git dependency, which crate_universe would fetch with git,
# outside Bazel's downloader and repository cache, so it could be neither
# cached by checksum nor built offline. Bazel builds it instead from a
# checksummed archive of the same commit; Cargo keeps using the git source.
# Bump PINTUI_COMMIT and the integrity together with the rev in Cargo.toml.
PINTUI_COMMIT = "6e412905f82be38857cf205d4623bbbfd5b61c10"

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "pintui",
    build_file = "//third_party/pintui:pintui.BUILD.bazel",
    integrity = "sha256-bB7DBYjIkTGKWebvE3s43k3u3X1cbq70l69jI8lcOAA=",
    strip_prefix = "pintui-{}/rust".format(PINTUI_COMMIT),
    urls = ["https://github.com/albertocavalcante/pintui/archive/{}.tar.gz".format(PINTUI_COMMIT)],
)

# Replace the git-fetched repository crate_universe would generate for pintui
# with the archive above. (A crate.annotation lib override is not enough:
# all_crate_deps() reaches pintui through the hub alias, which still points
# at the generated repository.)
override_repo(
    crate,
    **{"crates__pintui-0.1.0": "pintui"}
)

use_repo(crate, "crates")
